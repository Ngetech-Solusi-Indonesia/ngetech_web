---
import { t, type Locale } from '../i18n';
import { waLink } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<header class="header">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="Ngetech Solusi Indonesia">
      <Logo />
      <span>Ngetech</span>
    </a>
    <nav class="links" aria-label="Main">
      <a href="#demo">{d.nav.demo}</a>
      <a href="#why">{d.nav.why}</a>
      <a href="#status">{d.nav.status}</a>
      <a href="#team">{d.nav.team}</a>
    </nav>
    <div class="end">
      <LangSwitch locale={locale} label={d.nav.language} />
      <a class="btn btn-primary btn-sm cta" href={waLink(d.contact.waText)} target="_blank" rel="noopener">
        <Icon name="whatsapp-logo" size={16} /><span class="cta-label">{d.nav.cta}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 32px; height: 64px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .links { display: none; gap: 4px; margin-right: auto; }
  .links a {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .links a:hover { color: var(--ink); background: var(--surface-2); }
  .end { display: flex; align-items: center; gap: 12px; margin-left: auto; }

  @media (max-width: 559px) {
    .cta { padding: 0 11px; }
    .cta-label {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
  }
  @media (min-width: 900px) {
    .links { display: flex; }
    .end { margin-left: 0; }
  }
</style>
