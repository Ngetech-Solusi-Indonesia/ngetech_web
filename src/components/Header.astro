---
import { t, pathFor, type Locale } from '../i18n';
import { waLink } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { locale: Locale; alternates?: Record<Locale, string>; home?: boolean }
const { locale, alternates, home = true } = Astro.props;
// On subpages, section links go back to the home page.
const base = home ? '' : pathFor(locale);
const d = t(locale);
---
<header class="header">
  <span class="reading-progress" aria-hidden="true"></span>
  <div class="wrap bar">
    <a class="brand" href={`${base}#top`} aria-label="NgeTech Solusi Indonesia">
      <Logo />
      <span>NgeTech</span>
    </a>
    <nav class="links" aria-label="Main">
      <a href={`${base}#demo`}>{d.nav.demo}</a>
      <a href={`${base}#why`}>{d.nav.why}</a>
      <a href={`${base}#products`}>{d.nav.status}</a>
      <a href={`${base}#team`}>{d.nav.team}</a>
    </nav>
    <div class="end">
      <LangSwitch locale={locale} label={d.nav.language} alternates={alternates} />
      <a class="btn btn-primary btn-sm cta" href={waLink(d.contact.waText)} target="_blank" rel="noopener">
        <Icon name="whatsapp-logo" size={16} /><span class="cta-label">{d.nav.cta}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 200ms ease, background-color 200ms ease;
  }
  .header.is-scrolled { box-shadow: 0 4px 24px rgb(0 0 0 / .04); background: color-mix(in srgb, var(--bg) 94%, transparent); }
  .reading-progress { position: absolute; left: 0; bottom: -1px; width: 100%; height: 2px; background: var(--accent); transform: scaleX(var(--read-progress, 0)); transform-origin: left; pointer-events: none; }
  .bar { display: flex; align-items: center; gap: 32px; height: 72px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .links { display: none; gap: 4px; margin-right: auto; }
  .links a {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .links a:hover { color: var(--ink); background: var(--surface-2); }
  .end { display: flex; align-items: center; gap: 12px; margin-left: auto; }

  @media (max-width: 559px) {
    .cta { padding: 0 11px; }
    .cta-label {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
  }
  @media (min-width: 900px) {
    .links { display: flex; }
    .end { margin-left: 0; }
  }
</style>
