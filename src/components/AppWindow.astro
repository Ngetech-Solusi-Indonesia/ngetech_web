---
import { t, type Locale } from '../i18n';
import { boothPhotos } from '../data/ngebooth';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const a = d.app;

const tabs = [
  { key: 'inventory', label: a.inventory.tab, icon: 'package', status: 'in_use', pill: 'is-live' },
  { key: 'rfid', label: a.rfid.tab, icon: 'identification-card', status: 'in_development', pill: '' },
  { key: 'booth', label: a.booth.tab, icon: 'camera', status: 'internal_testing', pill: 'is-testing' },
] as const;

const total = a.rfid.seed.length + a.rfid.queue.length;
const strings = {
  out: a.inventory.logOut, in: a.inventory.logIn, low: a.inventory.low,
  read: a.rfid.read, waiting: a.rfid.waiting, full: a.rfid.full, present: a.rfid.present,
  queue: a.rfid.queue, seed: a.rfid.seed,
  ready: a.booth.ready, done: a.booth.done, start: a.booth.start, again: a.booth.again, frame: a.booth.frame,
  items: a.inventory.items, photos: boothPhotos,
};
---
<figure class="app" data-app data-strings={JSON.stringify(strings)} aria-label={a.label}>
  <div class="app-frame">
    <div class="app-tabs" role="tablist" aria-label={a.products}>
      {tabs.map((tab, i) => (
        <button
          role="tab"
          id={`tab-${tab.key}`}
          aria-controls={`panel-${tab.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-key={tab.key}
          class="app-tab"
        >
          <Icon name={tab.icon} size={18} />
          <span class="app-tab-label">{tab.label}</span>
          <span class={`pill app-tab-pill ${tab.pill}`}>{d.status[tab.status]}</span>
        </button>
      ))}
    </div>

    <!-- Inventory -->
    <section class="app-panel is-active" role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory" data-panel="inventory">
      <div class="inv">
        <div class="inv-main">
          <div class="panel-head">
            <p class="app-h">{a.inventory.title}</p>
            <label class="search">
              <Icon name="magnifying-glass" size={16} />
              <span class="visually-hidden">{a.inventory.search}</span>
              <input type="search" placeholder={a.inventory.search} data-inv-search autocomplete="off" />
            </label>
          </div>
          <table class="inv-table">
            <thead>
              <tr>
                <th scope="col">{a.inventory.colItem}</th>
                <th scope="col" class="col-place">{a.inventory.colPlace}</th>
                <th scope="col" class="col-qty">{a.inventory.colQty}</th>
                <th scope="col"><span class="visually-hidden">Aksi</span></th>
              </tr>
            </thead>
            <tbody>
              {a.inventory.items.map((item, i) => (
                <tr data-row={i} data-name={item.name.toLowerCase()}>
                  <td>
                    <span class="inv-name">{item.name}</span>
                    <span class="inv-unit">{item.unit}</span>
                  </td>
                  <td class="col-place">{item.place}</td>
                  <td class="col-qty">
                    <span class="inv-low" data-low hidden={item.qty > 5}>{a.inventory.low}</span>
                    <span class="num inv-qty" data-qty>{item.qty}</span>
                  </td>
                  <td class="inv-actions">
                    <div>
                    <button class="icon-btn" data-delta="-1" aria-label={`${a.inventory.out}: ${item.name}`}><Icon name="minus" size={14} /></button>
                    <button class="icon-btn" data-delta="1" aria-label={`${a.inventory.in}: ${item.name}`}><Icon name="plus" size={14} /></button>
                    </div>
                  </td>
                </tr>
              ))}
              <tr class="inv-empty" data-inv-empty hidden><td colspan="4">{a.inventory.empty}</td></tr>
            </tbody>
          </table>
        </div>
        <aside class="inv-log">
          <p class="app-sub">{a.inventory.log}</p>
          <ol data-inv-log aria-live="polite">
            {a.inventory.seedLog.map((e) => {
              const item = a.inventory.items.find((x) => x.name === e.name)!;
              return (
                <li>
                  <span class="log-name">{e.name}</span>
                  <span class="log-meta"><span class:list={['num', e.delta > 0 ? 'is-in' : 'is-out']}>{e.delta > 0 ? '+' : '−'}{Math.abs(e.delta)} {item.unit}</span><span class="num">{e.time}</span></span>
                </li>
              );
            })}
          </ol>
        </aside>
      </div>
    </section>

    <!-- RFID attendance -->
    <section class="app-panel" role="tabpanel" id="panel-rfid" aria-labelledby="tab-rfid" data-panel="rfid">
      <div class="rfid">
        <div class="reader" data-reader>
          <p class="reader-label">{a.rfid.reader}</p>
          <div class="reader-pad">
            <span class="reader-ring"></span>
            <Icon name="identification-card" size={40} />
          </div>
          <p class="reader-state" data-reader-state aria-live="polite">{a.rfid.waiting}</p>
          <div class="reader-actions">
            <button class="btn btn-primary btn-sm" data-tap><Icon name="identification-card" size={16} />{a.rfid.tap}</button>
            <button class="btn btn-ghost btn-sm" data-reset hidden><Icon name="arrow-counter-clockwise" size={16} />{a.rfid.reset}</button>
          </div>
        </div>
        <div class="roll">
          <div class="panel-head">
            <p class="app-h">{a.rfid.title}</p>
            <p class="roll-count"><span class="num" data-count>{a.rfid.seed.length}</span> <span class="roll-of">{a.rfid.of} <span class="num">{total}</span></span></p>
          </div>
          <ol class="roll-list" data-roll>
            {a.rfid.seed.map((p) => (
              <li><span class="roll-name">{p.name}</span><span class="num roll-time">{p.time}</span><span class="roll-ok"><Icon name="check" size={14} />{a.rfid.present}</span></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- NgeBooth -->
    <section class="app-panel booth" role="tabpanel" id="panel-booth" aria-labelledby="tab-booth" data-panel="booth">
      <div class="booth-grid">
        <div class="viewfinder">
          <span class="vf-corner tl"></span><span class="vf-corner tr"></span><span class="vf-corner bl"></span><span class="vf-corner br"></span>
          <p class="vf-count" data-vf aria-live="polite">{a.booth.ready}</p>
          <span class="vf-flash" data-flash></span>
        </div>
        <div class="booth-side">
          <div class="booth-head">
            <p class="app-h">{a.booth.title}</p>
            <p>{a.booth.layout}</p>
          </div>
          <div class="strip" data-strip>
            {[0, 1, 2, 3].map((i) => (
              <div class="strip-frame" data-frame={i}>
                {boothPhotos[i] ? <img src={boothPhotos[i]} alt="" loading="lazy" /> : <span class="num">{i + 1}</span>}
              </div>
            ))}
          </div>
          <button class="booth-btn" data-booth-start><Icon name="camera" size={16} /><span data-booth-label>{a.booth.start}</span></button>
          {boothPhotos.length === 0 && <p class="booth-note">{a.booth.note}</p>}
        </div>
      </div>
    </section>
  </div>
  <figcaption>{d.hero.demoNote}</figcaption>
</figure>

<script>
  import { initApp } from '../scripts/app';
  document.querySelectorAll<HTMLElement>('[data-app]').forEach(initApp);
</script>

<style is:global>
  .app { margin: 0; }
  .app figcaption { margin-top: 14px; font-size: var(--text-sm); color: var(--ink-3); }
  .app-frame {
    display: grid;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-window);
    overflow: clip;
    position: relative;
  }
  .app .app-h { font-weight: 600; font-size: 1rem; line-height: 1.3; letter-spacing: -0.01em; }

  /* Tabs: horizontal on small screens, sidebar on wide ones */
  .app-tabs {
    display: flex;
    gap: 4px;
    padding: 8px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .app-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    height: 36px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: left;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .app-tab:hover { color: var(--ink); }
  .app-tab[aria-selected='true'] { background: var(--surface); color: var(--ink); border-color: var(--line); box-shadow: 0 1px 2px rgb(0 0 0 / 0.05); }
  .app-tab-pill { display: none; }

  /* Small screens: three equal tabs, label over status */
  @media (max-width: 959px) {
    .app-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; }
    .app-tab { flex-direction: column; align-items: flex-start; gap: 2px; height: auto; min-height: 52px; padding: 8px 10px; }
    .app-tab > svg { display: none; }
    .app-tab-label { font-size: var(--text-xs); line-height: 1.3; }
    .app-tab .app-tab-pill.pill {
      display: block; height: auto; padding: 0; border: 0; background: none;
      font-size: 0.6875rem; line-height: 1.25; white-space: normal;
    }
  }

  @media (min-width: 960px) {
    .app-frame { grid-template-columns: 240px 1fr; }
    .app-tabs { flex-direction: column; border-bottom: 0; border-right: 1px solid var(--line); padding: 12px; gap: 2px; }
    .app-tab { height: auto; padding: 10px 12px; flex-wrap: wrap; row-gap: 6px; }
    .app-tab-label { flex: 1; }
    .app-tab-pill { display: inline-flex; flex-basis: 100%; width: max-content; flex-grow: 0; margin-left: 26px; }
  }

  .app-panel { min-width: 0; }
  .js .app-panel:not(.is-active) { display: none; }
  .app-panel.is-active { animation: panel-in 320ms var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .app-panel.is-active { animation: none; } }

  .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }

  .icon-btn {
    display: grid; place-items: center;
    width: 32px; height: 32px;
    border-radius: var(--radius-control);
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--ink-2);
    transition: border-color 150ms ease, color 150ms ease, transform 120ms ease;
  }
  .icon-btn:hover:not(:disabled) { border-color: var(--ink-3); color: var(--ink); }
  .icon-btn:active:not(:disabled) { transform: scale(0.94); }
  .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ---------- Inventory ---------- */
  .inv { display: grid; min-height: 400px; }
  .inv-main { padding: 20px; min-width: 0; }
  .search {
    display: flex; align-items: center; gap: 8px;
    height: 36px; padding: 0 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink-3);
    width: min(100%, 220px);
  }
  .search:focus-within { border-color: var(--accent); }
  .search input { border: 0; outline: 0; background: transparent; width: 100%; font-size: var(--text-sm); color: var(--ink); }
  .search input::placeholder { color: var(--ink-3); }
  .inv-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .inv-table th {
    text-align: left; font-weight: 500; color: var(--ink-3);
    font-size: var(--text-xs);
    padding: 0 12px 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .inv-table td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .inv-table tbody tr:last-of-type td { border-bottom: 0; }
  .inv-table tr { transition: background-color 900ms ease; }
  .inv-table tr.is-flash { background: var(--accent-soft); transition: none; }
  .inv-name { display: block; color: var(--ink); font-weight: 500; }
  .inv-unit { display: block; color: var(--ink-3); font-size: var(--text-xs); }
  .col-place { color: var(--ink-2); }
  .col-qty { text-align: right; white-space: nowrap; }
  th.col-qty { text-align: right; }
  .inv-qty { display: inline-block; min-width: 3ch; font-weight: 500; color: var(--ink); }
  .tick-up { animation: tick-up 420ms var(--ease-out); }
  .tick-down { animation: tick-down 420ms var(--ease-out); }
  @keyframes tick-up { from { opacity: 0; transform: translateY(60%); color: var(--accent); } 60% { color: var(--accent); } }
  @keyframes tick-down { from { opacity: 0; transform: translateY(-60%); color: var(--accent); } 60% { color: var(--accent); } }
  @media (prefers-reduced-motion: reduce) { .tick-up, .tick-down { animation: none; } }
  .inv-low {
    margin-right: 8px;
    font-size: 0.6875rem; font-weight: 500;
    color: var(--warn);
    padding: 2px 6px; border-radius: 4px;
    background: var(--warn-soft);
  }
  .inv-actions { padding-right: 0 !important; width: 1%; }
  .inv-actions > div { display: flex; gap: 6px; justify-content: flex-end; }
  .inv-empty td { color: var(--ink-3); padding-block: 24px; }
  .inv-log { padding: 20px; border-top: 1px solid var(--line); background: var(--surface-2); min-width: 0; }
  .inv-log .app-sub { font-size: var(--text-xs); font-weight: 500; color: var(--ink-3); margin-bottom: 12px; }
  .inv-log ol { list-style: none; padding: 0; display: grid; gap: 2px; }
  .inv-log li { padding: 8px 10px; border-radius: var(--radius-control); font-size: var(--text-sm); display: grid; gap: 2px; }
  .inv-log li.is-new { animation: log-in 1400ms var(--ease-out); }
  @keyframes log-in { 0% { background: var(--accent-soft); transform: translateY(-4px); opacity: 0; } 15% { opacity: 1; transform: none; } 100% { background: transparent; } }
  .log-name { color: var(--ink); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .log-meta { display: flex; justify-content: space-between; gap: 8px; color: var(--ink-3); font-size: var(--text-xs); }
  .log-meta .is-in { color: var(--accent); font-weight: 500; }
  .log-meta .is-out { color: var(--ink-2); font-weight: 500; }
  @media (max-width: 559px) { .col-place { display: none; } }
  @media (min-width: 1100px) {
    .inv { grid-template-columns: 1fr 260px; }
    .inv-log { border-top: 0; border-left: 1px solid var(--line); }
  }

  /* ---------- RFID ---------- */
  .rfid { display: grid; min-height: 400px; }
  .reader { display: grid; justify-items: center; align-content: center; gap: 16px; padding: 28px 20px; text-align: center; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  .reader-label { font-size: var(--text-xs); color: var(--ink-3); }
  .reader-pad {
    position: relative;
    display: grid; place-items: center;
    width: 112px; height: 112px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line-2);
    color: var(--ink-2);
    transition: color 200ms ease, border-color 200ms ease;
  }
  .reader-ring { position: absolute; inset: -1px; border-radius: 50%; border: 2px solid var(--accent); opacity: 0; }
  .reader.is-reading .reader-pad { color: var(--accent); border-color: var(--accent-line); }
  .reader.is-reading .reader-ring { animation: ring 700ms var(--ease-out); }
  @keyframes ring { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(1.35); } }
  .reader-state { font-size: var(--text-sm); color: var(--ink-2); min-height: 2.6em; max-width: 24ch; }
  .reader-state strong { display: block; color: var(--ink); font-weight: 500; }
  .reader-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .roll { padding: 20px; min-width: 0; }
  .roll-count { font-size: var(--text-sm); color: var(--ink-3); }
  .roll-count [data-count] { display: inline-block; font-size: 1.5rem; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
  .roll-list { list-style: none; padding: 0; font-size: var(--text-sm); }
  .roll-list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 16px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .roll-list li:last-child { border-bottom: 0; }
  .roll-list li.is-new { animation: roll-in 600ms var(--ease-out); }
  @keyframes roll-in { from { opacity: 0; transform: translateY(-6px); } }
  .roll-name { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .roll-time { color: var(--ink-3); }
  .roll-ok { display: inline-flex; align-items: center; gap: 4px; color: var(--accent); font-size: var(--text-xs); font-weight: 500; }
  @media (min-width: 720px) {
    .rfid { grid-template-columns: 280px 1fr; }
    .reader { border-bottom: 0; border-right: 1px solid var(--line); }
  }

  /* ---------- NgeBooth (own brand) ---------- */
  .booth { background: var(--booth-bg); color: var(--booth-ink); }
  .booth-grid { display: grid; gap: 20px; padding: 20px; min-height: 400px; }
  .viewfinder {
    position: relative;
    display: grid; place-items: center;
    min-height: 240px;
    border-radius: var(--radius-control);
    background: #1D1E1B;
    overflow: hidden;
  }
  .vf-corner { position: absolute; width: 18px; height: 18px; border: 0 solid var(--booth-lime); }
  .vf-corner.tl { top: 14px; left: 14px; border-top-width: 2px; border-left-width: 2px; }
  .vf-corner.tr { top: 14px; right: 14px; border-top-width: 2px; border-right-width: 2px; }
  .vf-corner.bl { bottom: 14px; left: 14px; border-bottom-width: 2px; border-left-width: 2px; }
  .vf-corner.br { bottom: 14px; right: 14px; border-bottom-width: 2px; border-right-width: 2px; }
  .vf-count { font-size: 1rem; font-weight: 500; color: var(--booth-ink-2); font-variant-numeric: tabular-nums; }
  .vf-count.is-big { font-size: 5rem; font-weight: 600; color: var(--booth-lime); letter-spacing: -0.04em; line-height: 1; }
  .vf-count.is-done { color: var(--booth-lime); }
  .vf-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .vf-flash.go { animation: flash 420ms ease-out; }
  @keyframes flash { from { opacity: 0.9; } to { opacity: 0; } }
  .booth-side { display: grid; gap: 16px; align-content: start; }
  .booth-head p { font-size: var(--text-xs); color: var(--booth-ink-2); }
  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    padding: 6px;
    background: #F4F4EF;
    border-radius: 4px;
    outline: 2px solid transparent;
    outline-offset: 4px;
    transition: outline-color 300ms ease;
  }
  .strip.is-done { outline-color: var(--booth-lime); }
  .strip-frame {
    display: grid; place-items: center;
    aspect-ratio: 4 / 3;
    background: #DCDCD5;
    color: #8B8B84;
    font-size: var(--text-xs);
    border-radius: 2px;
    overflow: hidden;
    transition: background-color 250ms ease, color 250ms ease;
  }
  .strip-frame img { width: 100%; height: 100%; object-fit: cover; opacity: 0.15; transition: opacity 300ms ease; }
  .strip-frame.is-filled { background: #2B2D28; color: var(--booth-lime); }
  .strip-frame.is-filled img { opacity: 1; }
  .booth-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 40px; padding: 0 16px;
    border: 0; border-radius: var(--radius-control);
    background: var(--booth-lime); color: #141513;
    font-size: var(--text-sm); font-weight: 600;
    transition: transform 120ms ease, opacity 150ms ease;
  }
  .booth-btn:active:not(:disabled) { transform: scale(0.98); }
  .booth-btn:disabled { opacity: 0.5; cursor: progress; }
  .booth-btn:focus-visible { outline-color: var(--booth-lime); }
  .booth-note { font-size: var(--text-xs); color: var(--booth-ink-2); }
  @media (min-width: 720px) {
    .booth-grid { grid-template-columns: 1fr 240px; }
    .strip { grid-template-columns: 1fr; width: 92px; justify-self: start; }
  }
</style>
