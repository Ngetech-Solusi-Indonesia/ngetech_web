---
import { t, type Locale } from '../i18n';
import { site, waLink } from '../data/site';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="section contact" id="contact">
  <div class="wrap">
    <div class="panel">
      <h2>{d.contact.title}</h2>
      <p class="body">{d.contact.body}</p>
      <a class="btn btn-primary btn-lg" href={waLink(d.contact.waText)} target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={20} />{d.contact.cta}</a>
      <div class="meta">
        <p><Icon name="envelope-simple" size={16} />{d.contact.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><Icon name="map-pin" size={16} />{d.contact.location}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { padding-top: 0; }
  .panel {
    display: grid;
    justify-items: start;
    gap: 0;
    padding: clamp(32px, 6vw, 80px);
    border-radius: var(--radius-surface);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  h2 { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem); letter-spacing: -0.04em; line-height: 1.04; max-width: 16em; }
  .body { margin-top: 16px; max-width: 36rem; font-size: var(--text-xl); line-height: 1.5; color: var(--ink-2); }
  .btn-lg { margin-top: 32px; min-height: 52px; padding: 0 24px; font-size: var(--text-lg); }
  .btn-lg :global(svg) { width: 20px; height: 20px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 28px; font-size: var(--text-sm); color: var(--ink-3); }
  .meta p { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .meta a { color: var(--ink); overflow-wrap: anywhere; }
</style>
