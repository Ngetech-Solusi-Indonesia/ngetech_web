---
import { t, type Locale } from '../i18n';
import StatusLabel from './StatusLabel.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const demo = d.demo;

// Sample data only. The figure caption says so on the page.
const people = [
  { name: 'Nadia Putri', time: '07:06' },
  { name: 'Bagas Ramadhan', time: '07:03' },
  { name: 'Fikri Hidayat', time: '06:58' },
];
const newcomer = { name: 'Rani Aulia', time: '07:12' };
const stock = [
  { name: demo.inventory.items[0], from: 120, to: 118, hot: true },
  { name: demo.inventory.items[1], from: 14, to: 14 },
  { name: demo.inventory.items[2], from: 305, to: 305 },
];

// Final state = what readers without JS or with reduced motion see.
const FINAL = {
  rfid: 'card read row',
  inventory: 'scan dec log',
  booth: 'f1 f2 f3 f4 done',
};
---
<figure class="demo" data-demo aria-label={d.hero.demoLabel}>
  <div class="panels" aria-hidden="true">
    <!-- RFID attendance -->
    <div class="panel" data-panel="rfid" data-on={FINAL.rfid}>
      <div class="ptop">
        <span class="pname">{demo.rfid.title}</span>
        <StatusLabel status="in_development" text={d.status.in_development} />
      </div>
      <div class="pbody">
        <div class="reader-row">
          <div class="reader"><span class="led"></span></div>
          <div class="card"><span class="chip"></span></div>
          <span class="read-msg mono">{demo.rfid.tap} · {newcomer.time}:04</span>
        </div>
        <p class="phead mono">{demo.rfid.head}</p>
        <ul class="rows">
          <li class="row new"><div><span>{newcomer.name}</span><span class="mono t">{newcomer.time}</span><span class="mono ok">{demo.rfid.present}</span></div></li>
          {people.map((p) => (
            <li class="row"><div><span>{p.name}</span><span class="mono t">{p.time}</span><span class="mono ok">{demo.rfid.present}</span></div></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Inventory -->
    <div class="panel" data-panel="inventory" data-on={FINAL.inventory}>
      <div class="ptop">
        <span class="pname">{demo.inventory.title}</span>
        <StatusLabel status="in_use" text={d.status.in_use} />
      </div>
      <div class="pbody">
        <p class="phead mono">{demo.inventory.head}</p>
        <div class="table">
          <div class="th mono"><span>{demo.inventory.colItem}</span><span>{demo.inventory.colQty}</span></div>
          {stock.map((s) => (
            <div class:list={['tr', s.hot && 'hot']}>
              <span>{s.name}</span>
              {s.hot ? (
                <span class="qty mono"><span class="q-old">{s.from}</span><span class="q-new">{s.to}</span></span>
              ) : (
                <span class="qty mono"><span>{s.from}</span></span>
              )}
            </div>
          ))}
        </div>
        <p class="log mono"><span class="arrow">↘</span> {demo.inventory.log} · 07:12</p>
      </div>
    </div>

    <!-- NgeBooth (keeps its own brand colours) -->
    <div class="panel booth" data-panel="booth" data-on={FINAL.booth}>
      <div class="ptop">
        <span class="pname">{demo.booth.title}</span>
        <StatusLabel status="internal_testing" text={d.status.internal_testing} tone="booth" />
      </div>
      <div class="pbody">
        <p class="phead mono">{demo.booth.head}</p>
        <div class="booth-grid">
          <div class="viewfinder">
            <span class="corner c-tl"></span><span class="corner c-tr"></span><span class="corner c-bl"></span><span class="corner c-br"></span>
            <svg class="sitter" viewBox="0 0 100 80"><circle cx="50" cy="32" r="13" /><path d="M24 80c0-16 12-26 26-26s26 10 26 26z" /></svg>
            <span class="flash"></span>
            <span class="count mono" data-count>4/4</span>
          </div>
          <div class="strip">
            {[1, 2, 3, 4].map((n) => (
              <div class={`frame fr${n}`}>
                <svg viewBox="0 0 100 80"><circle cx="50" cy="32" r="13" /><path d="M24 80c0-16 12-26 26-26s26 10 26 26z" /></svg>
              </div>
            ))}
          </div>
        </div>
        <p class="done mono">{demo.booth.done}</p>
      </div>
    </div>
  </div>

  <div class="timeline" aria-hidden="true">
    <div class="track">
      <span class="tick" style="left:26%"></span>
      <span class="tick" style="left:46%"></span>
      <span class="tick" style="left:78%"></span>
      <span class="fill" data-fill></span>
    </div>
    <span class="clock mono" data-clock>00:06.0</span>
  </div>
  <figcaption class="mono">{d.hero.demoNote}</figcaption>
</figure>

<script>
  import { startDemo } from '../scripts/demo';
  startDemo();
</script>

<style>
  .demo { margin: 0; }
  .panels {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .panel {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    height: 300px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ptop {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .pname { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; }
  .pbody {
    flex: 1;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: opacity 250ms ease;
  }
  .phead { color: var(--ink-3); font-size: var(--step--2); }
  [data-on~='out'] .pbody { opacity: 0; }
  .snap, .snap * { transition: none !important; }

  /* ---------- RFID ---------- */
  .reader-row { position: relative; height: 46px; display: flex; align-items: center; }
  .reader {
    width: 46px; height: 46px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    display: grid; place-items: center;
    background: var(--surface-2);
  }
  .led {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 120ms ease, box-shadow 120ms ease;
  }
  [data-on~='read'] .led { background: var(--accent-mark); box-shadow: 0 0 0 4px var(--accent-soft); }
  .card {
    position: absolute;
    left: 0; top: 7px;
    width: 52px; height: 32px;
    border-radius: 4px;
    background: var(--ink);
    transform: translateX(170px) rotate(-4deg);
    opacity: 0;
    transition: transform 520ms cubic-bezier(.2,.7,.2,1), opacity 200ms ease;
  }
  .chip { position: absolute; left: 8px; top: 9px; width: 10px; height: 8px; border-radius: 2px; background: var(--accent-mark); }
  [data-on~='card'] .card { transform: translateX(26px) rotate(0); opacity: 1; }
  .read-msg {
    margin-left: 96px;
    font-size: var(--step--2);
    color: var(--accent-ink);
    opacity: 0;
    transform: translateY(4px);
    visibility: hidden;
    transition: opacity 200ms ease, transform 200ms ease, visibility 0s 200ms;
  }
  [data-on~='read'] .read-msg { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }

  .rows { list-style: none; padding: 0; display: grid; font-size: 0.875rem; }
  .row { display: grid; grid-template-rows: 1fr; transition: grid-template-rows 320ms ease, background-color 600ms ease; }
  .row > div {
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    align-items: center;
    border-top: 1px solid var(--line);
    min-height: 0;
  }
  .row > div > * { padding-block: 7px; }
  .row .t { color: var(--ink-2); font-size: var(--step--2); }
  .row .ok { color: var(--status-in-use); font-size: var(--step--2); }
  .row.new { grid-template-rows: 0fr; }
  [data-on~='row'] .row.new { grid-template-rows: 1fr; background: var(--accent-soft); }

  /* ---------- Inventory ---------- */
  .table { display: grid; font-size: 0.875rem; }
  .th, .tr {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 8px 6px;
    border-top: 1px solid var(--line);
  }
  .th { color: var(--ink-3); font-size: var(--step--2); border-top: 0; padding-top: 0; }
  .tr { transition: background-color 300ms ease; border-radius: 2px; }
  [data-on~='scan'] .tr.hot { background: var(--accent-soft); }
  .qty { position: relative; display: inline-grid; justify-items: end; overflow: hidden; min-width: 3ch; }
  .qty > span { grid-area: 1 / 1; transition: transform 300ms ease, opacity 300ms ease, visibility 0s; }
  .q-new { transform: translateY(100%); opacity: 0; visibility: hidden; transition-delay: 0s, 0s, 300ms; }
  [data-on~='dec'] .q-old { opacity: 0; visibility: hidden; transition: none; }
  [data-on~='dec'] .q-new { transform: none; opacity: 1; visibility: visible; font-weight: 500; transition-delay: 0s; }
  .log {
    margin-top: auto;
    font-size: var(--step--2);
    color: var(--ink-2);
    padding: 8px 10px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    opacity: 0;
    transform: translateY(6px);
    visibility: hidden;
    transition: opacity 250ms ease, transform 250ms ease, visibility 0s 250ms;
  }
  .arrow { color: var(--accent-ink); }
  [data-on~='log'] .log { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }

  /* ---------- NgeBooth ---------- */
  .booth { background: var(--booth-bg); border-color: #262724; color: var(--booth-ink); }
  .booth .ptop { border-color: #262724; }
  .booth .phead { color: #9A9A92; }
  .booth-grid { flex: 1; display: grid; grid-template-columns: 1fr 64px; gap: 12px; min-height: 0; }
  .viewfinder {
    position: relative;
    border-radius: 4px;
    background: #1F201D;
    overflow: hidden;
    display: grid;
    place-items: end center;
  }
  .sitter { width: 70%; fill: #33352F; }
  .corner { position: absolute; width: 12px; height: 12px; border: 0 solid var(--booth-lime); }
  .c-tl { top: 8px; left: 8px; border-top-width: 2px; border-left-width: 2px; }
  .c-tr { top: 8px; right: 8px; border-top-width: 2px; border-right-width: 2px; }
  .c-bl { bottom: 8px; left: 8px; border-bottom-width: 2px; border-left-width: 2px; }
  .c-br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; }
  .count { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); color: var(--booth-lime); font-size: var(--step--2); }
  .flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .flash.go { animation: flash 380ms ease-out; }
  @keyframes flash { from { opacity: .85; } to { opacity: 0; } }
  .strip {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 4px;
    padding: 4px;
    background: #F2F2EC;
    border-radius: 2px;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 250ms ease;
  }
  .frame { background: #DCDCD4; border-radius: 1px; display: grid; place-items: end center; overflow: hidden; }
  .frame svg { width: 80%; fill: transparent; transition: fill 200ms ease; }
  .frame { transition: background-color 200ms ease; }
  [data-on~='f1'] .fr1, [data-on~='f2'] .fr2, [data-on~='f3'] .fr3, [data-on~='f4'] .fr4 { background: #2A2C27; }
  [data-on~='f1'] .fr1 svg, [data-on~='f2'] .fr2 svg, [data-on~='f3'] .fr3 svg, [data-on~='f4'] .fr4 svg { fill: var(--booth-lime); }
  [data-on~='done'] .strip { outline-color: var(--booth-lime); }
  .done {
    font-size: var(--step--2);
    color: var(--booth-lime);
    opacity: 0;
    visibility: hidden;
    transition: opacity 250ms ease, visibility 0s 250ms;
  }
  [data-on~='done'] .done { opacity: 1; visibility: visible; transition-delay: 0s; }

  /* ---------- Shared timeline ---------- */
  .timeline { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-4); }
  .track { position: relative; flex: 1; height: 1px; background: var(--line-strong); }
  .tick { position: absolute; top: -3px; width: 1px; height: 7px; background: var(--ink-3); }
  .fill {
    position: absolute; inset: 0;
    background: var(--accent-mark);
    transform-origin: left;
    transform: scaleX(1);
    height: 2px; top: -0.5px;
  }
  .clock { color: var(--ink-3); font-size: var(--step--2); font-variant-numeric: tabular-nums; }
  figcaption { margin-top: var(--space-3); color: var(--ink-3); font-size: var(--step--2); }
</style>
