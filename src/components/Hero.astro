---
import { t, type Locale } from '../i18n';
import { waLink } from '../data/site';
import DemoPanels from './DemoPanels.astro';
import WaIcon from './WaIcon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="hero" id="top">
  <div class="wrap">
    <div class="copy">
      <p class="label"><span>Bandung</span><span aria-hidden="true">/</span><span>ngetech.studio</span></p>
      <h1>{d.hero.title}</h1>
      <p class="sub">{d.hero.sub}</p>
      <div class="actions">
        <a class="btn btn-primary" href={waLink(d.contact.waText)} target="_blank" rel="noopener"><WaIcon />{d.hero.cta}</a>
        <a class="btn btn-ghost" href="#projects">{d.hero.secondary} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <DemoPanels locale={locale} />
  </div>
</section>

<style>
  .hero { padding-block: clamp(40px, 7vw, 96px) var(--section-gap); }
  .copy { display: grid; gap: var(--space-5); margin-bottom: clamp(40px, 6vw, 72px); }
  h1 { font-size: var(--step-4); max-width: 20ch; }
  .sub { font-size: var(--step-1); color: var(--ink-2); max-width: 56ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
</style>
