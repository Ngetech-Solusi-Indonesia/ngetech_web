---
import { t, type Locale } from '../i18n';
import { waLink } from '../data/site';
import AppWindow from './AppWindow.astro';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="hero" id="top">
  <div class="wrap">
    <h1 class="in" style="--i:0">{d.hero.title}</h1>
    <p class="sub in" style="--i:1">{d.hero.sub}</p>
    <div class="actions in" style="--i:2">
      <a class="btn btn-primary" href={waLink(d.contact.waText)} target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} />{d.hero.cta}</a>
      <a class="btn btn-ghost" href="#status">{d.hero.secondary}<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="demo app-in" id="demo">
      <AppWindow locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(48px, 6vw, 88px); padding-bottom: clamp(32px, 4vw, 56px); }
  h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 15em;
  }
  .sub {
    margin-top: 20px;
    max-width: 36rem;
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .demo { margin-top: clamp(48px, 6vw, 72px); scroll-margin-top: 88px; }

  /* The page's one authored entrance. Content is visible without it. */
  @media (prefers-reduced-motion: no-preference) {
    .in { animation: rise 900ms var(--ease-out) both; animation-delay: calc(var(--i) * 80ms); }
    .app-in { animation: rise-window 1200ms var(--ease-out) 240ms both; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); filter: blur(6px); }
  }
  @keyframes rise-window {
    from { opacity: 0; transform: translateY(40px) scale(0.985); filter: blur(12px); }
  }
</style>
