---
// NgeTech mark (cup, leaf and circuit) from the org's own logo:
// github.com/Ngetech-Solusi-Indonesia/.github, master in public/brand/.
// The artwork is drawn on white, so it always sits on a white tile
// (like an app icon) instead of being cut out or recoloured.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="logo-tile" style={`--s:${size}px`}>
  <img
    src="/brand/ngetech-mark-64.png"
    srcset="/brand/ngetech-mark-64.png 2x, /brand/ngetech-mark.png 4x"
    width={size - 4}
    height={size - 4}
    alt=""
    decoding="async"
  />
</span>

<style>
  .logo-tile {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    flex: none;
    border-radius: 8px;
    background: #FFFFFF;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (prefers-color-scheme: dark) {
    .logo-tile { box-shadow: none; }
  }
</style>
