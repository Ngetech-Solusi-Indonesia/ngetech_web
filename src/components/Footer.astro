---
import { t, type Locale } from '../i18n';
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';

interface Props { locale: Locale; alternates?: Record<Locale, string> }
const { locale, alternates } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap row">
    <div class="left">
      <Logo size={22} />
      <p>© {year} {site.legalName ?? site.name}. {d.footer.rights}</p>
    </div>
    <div class="right">
      <a href={`https://github.com/${site.githubOrg}`} rel="noopener">{d.footer.github}</a>
      <LangSwitch locale={locale} label={d.nav.language} alternates={alternates} />
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 28px; font-size: var(--text-sm); color: var(--ink-3); }
  .row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; }
  .left, .right { display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap; }
  a { color: var(--ink-2); text-decoration: none; }
  a:hover { color: var(--ink); }
</style>
