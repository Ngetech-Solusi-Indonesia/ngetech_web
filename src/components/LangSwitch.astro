---
import { pathFor, locales, type Locale } from '../i18n';
interface Props { locale: Locale; label: string; alternates?: Record<Locale, string> }
const { locale, label } = Astro.props;
const alternates = Astro.props.alternates ?? { id: pathFor('id'), en: pathFor('en') };
---
<nav class="lang" aria-label={label}>
  {locales.map((l) => (
    <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined} data-lang-link>
      {l.toUpperCase()}
    </a>
  ))}
</nav>

<script>
  // Keep the reader on the same section when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.hash) a.href = a.pathname + location.hash;
    });
  });
</script>

<style>
  .lang {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border-radius: var(--radius-control);
    background: var(--surface-2);
    font-size: 0.75rem;
    font-weight: 500;
  }
  a {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 28px;
    padding: 0 6px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--ink-3);
    transition: color 150ms ease, background-color 150ms ease;
  }
  a:hover { color: var(--ink); }
  a[aria-current] { color: var(--ink); background: var(--surface); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
</style>
