---
import { pathFor, locales, type Locale } from '../i18n';
interface Props { locale: Locale; label: string }
const { locale, label } = Astro.props;
---
<nav class="lang" aria-label={label}>
  {locales.map((l) => (
    <a
      href={pathFor(l)}
      hreflang={l}
      lang={l}
      aria-current={l === locale ? 'true' : undefined}
      data-lang-link
    >{l.toUpperCase()}</a>
  ))}
</nav>

<script>
  // Keep the reader on the same section when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.hash) a.href = a.pathname + location.hash;
    });
  });
</script>

<style>
  .lang {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }
  a {
    padding: 6px 9px;
    min-width: 36px;
    text-align: center;
    text-decoration: none;
    color: var(--ink-3);
  }
  a + a { border-left: 1px solid var(--line-strong); }
  a[aria-current] { color: var(--ink); background: var(--surface-2); }
  a:hover:not([aria-current]) { color: var(--ink); }
</style>
