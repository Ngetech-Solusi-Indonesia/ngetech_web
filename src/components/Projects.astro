---
import { t, type Locale } from '../i18n';
import { projects } from '../data/projects';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const pillClass = { in_use: 'is-live', internal_testing: 'is-testing', in_development: '' } as const;
---
<section class="section" id="status">
  <div class="wrap">
    <div class="section-head">
      <h2>{d.projects.title}</h2>
      <p>{d.projects.sub}</p>
    </div>
    <div class="table" role="table" aria-label={d.projects.title}>
      <div class="tr th" role="row">
        <span role="columnheader">{d.projects.colProduct}</span>
        <span role="columnheader">{d.projects.colFor}</span>
        <span role="columnheader">{d.projects.colStatus}</span>
      </div>
      {projects.map((p) => {
        const c = d.projects[p.key];
        return (
          <div class="tr item" role="row" data-key={p.key}>
            <div role="cell" class="product">
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
            </div>
            <span role="cell" class="for">{c.for}</span>
            <span role="cell" class="status"><span class={`pill ${pillClass[p.status]}`}>{d.status[p.status]}</span></span>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .table { border-top: 1px solid var(--ink); }
  .tr { display: grid; gap: 8px 24px; padding-block: 22px; border-bottom: 1px solid var(--line); }
  .th { display: none; }
  .product { display: grid; gap: 4px; }
  .product p { color: var(--ink-2); max-width: 46ch; }
  .for { color: var(--ink-2); font-size: var(--text-sm); }
  .status { margin-top: 4px; }

  @media (min-width: 760px) {
    .tr { grid-template-columns: minmax(0, 6fr) minmax(0, 3fr) minmax(0, 3fr); align-items: start; }
    .th { display: grid; padding-block: 12px; font-size: var(--text-xs); color: var(--ink-3); font-weight: 500; }
    .for { font-size: var(--text-base); padding-top: 1px; }
    .status { margin-top: 0; }
  }
</style>
