---
// Phosphor icons (regular weight), inlined at build time.
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw.replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} `);
---
<Fragment set:html={svg} />
