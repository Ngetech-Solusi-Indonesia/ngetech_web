---
import { t, type Locale } from '../i18n';
import { team } from '../data/team';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="section team" id="team">
  <div class="wrap">
    <div class="section-head">
      <h2>{d.team.title}</h2>
      <p>{d.team.sub}</p>
    </div>
    <ul class="roster">
      {team.map((m) => (
        <li>
          <p class="name">{m.name}</p>
          <p class="role">{m.role[locale]}</p>
          {(m.github || m.linkedin) && (
            <p class="links">
              {m.github && <a href={`https://github.com/${m.github}`} rel="noopener" aria-label={`GitHub ${m.name}`}><Icon name="github-logo" size={16} /></a>}
              {m.linkedin && <a href={m.linkedin} rel="noopener">LinkedIn <Icon name="arrow-up-right" size={12} /></a>}
            </p>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team { border-top: 1px solid var(--line); }
  .roster {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 32px 24px;
  }
  li { display: grid; gap: 2px; align-content: start; padding-top: 16px; border-top: 1px solid var(--line-2); }
  .name { font-weight: 500; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .role { color: var(--ink-3); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .links { display: flex; gap: 12px; margin-top: 8px; font-size: var(--text-sm); }
  .links a { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-2); text-decoration: none; }
  .links a:hover { color: var(--ink); }
</style>
