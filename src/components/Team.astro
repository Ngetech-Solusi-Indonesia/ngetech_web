---
import { t, type Locale } from '../i18n';
import { team, profilePath } from '../data/team';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="section team" id="team">
  <div class="wrap">
    <div class="section-head">
      <h2>{d.team.title}</h2>
      <p>{d.team.sub}</p>
    </div>
    <ul class="roster">
      {team.map((m) => (
        <li>
          <a class="card" href={profilePath(locale, m.slug)}>
            <span class="name">{m.name}</span>
            <span class="role">{m.role[locale]}</span>
            <span class="more">{d.team.profile}<Icon name="arrow-right" size={14} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team { border-top: 1px solid var(--line); }
  .roster {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    height: 100%;
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 150ms ease;
  }
  .card:hover { border-color: var(--ink-3); }
  .name { font-weight: 600; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .role { color: var(--ink-3); font-size: var(--text-sm); }
  .more {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: auto;
    padding-top: 14px;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .card:hover .more { color: var(--ink); }
</style>
