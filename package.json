{
  "name": "ngetech-web",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "check:content": "node scripts/check-todo.mjs",
    "build": "node scripts/check-todo.mjs && node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "build:preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "cms:user": "node --env-file-if-exists=.env scripts/cms-user.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "astro": "7.3.6",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1"
  }
}
